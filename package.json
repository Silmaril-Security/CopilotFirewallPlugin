{
  "name": "@silmaril/copilot-firewall-plugin",
  "version": "0.3.6",
  "description": "Silmaril Firewall lifecycle protection for GitHub Copilot CLI.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "keywords": [
    "copilot-cli",
    "ai-security",
    "firewall",
    "prompt-injection"
  ],
  "homepage": "https://www.silmaril.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silmaril-Security/CopilotFirewallPlugin.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run build && node --import tsx --test test/*.test.ts test/*.test.mjs && node scripts/test-classification-deadline.mjs",
    "test:native": "node scripts/native-qualification.mjs",
    "pack:dry": "npm pack --dry-run",
    "test:deadline": "npm run build && node scripts/test-classification-deadline.mjs"
  },
  "dependencies": {
    "@silmaril-security/sdk": "0.8.2"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.30-preview.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
